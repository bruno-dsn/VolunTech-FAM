{
  "name": "voluntech-fam",
  "version": "1.0.2",
  "description": "VolunTech: sistema acadêmico de gestão de voluntariado (projeto FAM).",
  "author": "Equipe VolunTech · FAM",
  "private": true,
  "main": "main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/electron-server.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "electron": "electron .",
    "electron:dev": "electron .",
    "electron:build": "pnpm build && electron-builder",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern release --ignore-pattern .sites-runtime --ignore-pattern .wrangler",
    "db:generate": "drizzle-kit generate",
    "dist:win": "pnpm build && electron-builder --win nsis",
    "dist:mac": "pnpm build && electron-builder --mac dmg",
    "dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "fflate": "0.7.4",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "uqr": "^0.1.3",
    "wrangler": "4.92.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "build": {
    "appId": "br.com.voluntech.fam",
    "productName": "VolunTech",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "dist/**/*",
      "scripts/**/*",
      "build/**/*",
      "lib/**/*",
      "db/**/*",
      "drizzle/**/*",
      "public/**/*",
      "components/**/*",
      "app/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "main.js",
      "package.json",
      "dist/**/*",
      "scripts/**/*",
      "build/**/*",
      "lib/**/*",
      "db/**/*",
      "drizzle/**/*",
      "public/**/*",
      "components/**/*",
      "app/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VolunTech-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VolunTech"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "artifactName": "VolunTech-${version}-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "artifactName": "VolunTech-${version}-${arch}.${ext}"
    },
    "icon": "build/icon.png"
  }
}
